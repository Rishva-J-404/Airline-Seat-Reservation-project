# ============================================================
# Airline Seat Reservation Backend Environment Variables
# Duplicate this file to .env and configure for your local setup
# ============================================================

PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=airline_dsa_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# CORS Configuration
CLIENT_ORIGIN=http://localhost:5173
