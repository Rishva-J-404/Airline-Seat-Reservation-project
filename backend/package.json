{
  "name": "airline-dsa-backend",
  "version": "1.0.0",
  "description": "Production REST API backend with academic DSA validation and relational database persistence",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "test:mock": "node --test tests/auth.test.js tests/dsa.test.js tests/flights.test.js tests/reservations.test.js",
    "test:postgres": "node --test tests/postgres.integration.test.js",
    "db:setup:staging": "node tests/setupStagingDb.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
