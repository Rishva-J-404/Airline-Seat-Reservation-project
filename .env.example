# ============================================================
# .env.example - Environment Template for FlySmart Airline DSA Lab
# Copy this file to .env and adjust variables as needed.
# ============================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=airline_dsa
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/airline_dsa

# Backend Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super-secure-jwt-secret-for-airline-dsa-lab-2026
CORS_ORIGIN=http://localhost:5173

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
